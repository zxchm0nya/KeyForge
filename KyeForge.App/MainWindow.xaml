<Window x:Class="KyeForge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KyeForge.App"
        xmlns:views="clr-namespace:KyeForge.App.Views"
        xmlns:vm="clr-namespace:KyeForge.App.ViewModels"
        mc:Ignorable="d"
        Title="KeyForge — Keyboard Configurator"
        Width="1200" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeepBrush}"
        FontFamily="{StaticResource FontFamily}"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
        <views:InverseVisibilityConverter x:Key="InvVis" />
        <views:ConnectedToVisibilityConverter x:Key="ConnectedToVis" />
    </Window.Resources>

    <Grid x:Name="OverlayRoot">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Custom background (behind everything): static image, GIF or video -->
        <Border x:Name="BgImageHost" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.CacheMode>
                <BitmapCache />
            </Border.CacheMode>
            <Border.Background>
                <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Image x:Name="BgGifHost" Grid.ColumnSpan="2" Visibility="Collapsed"
               Stretch="UniformToFill" IsHitTestVisible="False" />
        <MediaElement x:Name="BgVideoHost" Grid.ColumnSpan="2" Visibility="Collapsed"
                      Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      Volume="0" IsMuted="True" IsHitTestVisible="False" />
        <Border x:Name="BgDimHost" Grid.ColumnSpan="2" Background="#000000" Opacity="0" IsHitTestVisible="False" />

        <!-- ============ SIDEBAR ============ -->
        <Border x:Name="SidebarHost" Grid.Column="0" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid x:Name="SidebarInnerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel x:Name="SidebarBrand" Grid.Row="0" Margin="24,24,24,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KeyForge" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource t_app_subtitle}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="BrandDivider" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,0" />
                </StackPanel>

                <!-- Nav (selection pill glides between items) -->
                <Grid x:Name="NavGrid" Grid.Row="1" Margin="14,0,14,0" ClipToBounds="True">
                    <Border x:Name="NavIndicator" CornerRadius="12" Visibility="Collapsed"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="40"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavIndicatorShift" X="0" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel x:Name="NavStack">
                        <views:NavButton x:Name="NavDevices" Tag="devices" Label="{DynamicResource t_nav_devices}" Icon="devices"
                                         AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Label}" />
                        <views:NavButton x:Name="NavKeymap" Tag="keymap" Label="{DynamicResource t_nav_keymap}" Icon="keymap"
                                         AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Label}" />
                        <views:NavButton x:Name="NavLighting" Tag="lighting" Label="{DynamicResource t_nav_lighting}" Icon="lighting"
                                         AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Label}" />
                        <views:NavButton x:Name="NavTest" Tag="keytest" Label="{DynamicResource t_nav_keytest}" Icon="keytest"
                                         AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Label}" />
                        <views:NavButton x:Name="NavSettings" Tag="settings" Label="{DynamicResource t_nav_settings}" Icon="settings"
                                         AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Label}" />
                    </StackPanel>
                </Grid>

                <!-- Footer status -->
                <Border x:Name="SidebarFooter" Grid.Row="2" Margin="20,0,20,20" Padding="14,12"
                        CornerRadius="12" Background="{DynamicResource BgCardBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B7690" Margin="0,2,8,0" />
                            <TextBlock x:Name="StatusText" Text="{DynamicResource t_status_disconnected}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       AutomationProperties.AutomationId="statusText" />
                        </StackPanel>
                        <TextBlock x:Name="DeviceNameFooter" Text="" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="footerDevice" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid x:Name="ContentHost" Grid.Column="1" Background="{DynamicResource BgDeepBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,14,24,10">
                <Grid>
                    <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="pageTitle" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="ConfigBadge" Visibility="Collapsed"
                                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ConfigBadgeText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnAbout" Style="{StaticResource WindowButtonStyle}" Width="34" Height="34"
                                Focusable="False"
                                ToolTip="{DynamicResource t_tooltip_about}"
                                AutomationProperties.Name="{DynamicResource t_tooltip_about}"
                                Click="BtnAbout_Click">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="24,4,24,20">
                <views:DevicesView x:Name="PageDevices" />
                <views:KeymapView x:Name="PageKeymap" Visibility="Collapsed" />
                <views:LightingView x:Name="PageLighting" Visibility="Collapsed" />
                <views:KeyTestView x:Name="PageKeyTest" Visibility="Collapsed" />
                <views:SettingsView x:Name="PageSettings" Visibility="Collapsed" />
            </Grid>
        </Grid>

    </Grid>

        <!-- ============ UPDATE TOAST (overlay: outside RootGrid so it never affects layout) ============ -->
        <Border x:Name="UpdateToast" Panel.ZIndex="50"
                Visibility="Collapsed" IsHitTestVisible="True"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0" Width="360" MaxHeight="420"
                CornerRadius="14" Padding="16"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="UpdateToastTitle" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                            Style="{StaticResource SecondaryButton}" Focusable="False"
                            ToolTip="{DynamicResource t_updates_toast_close}"
                            AutomationProperties.Name="{DynamicResource t_updates_toast_close}"
                            Click="UpdateToastClose_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
                <Border x:Name="UpdateToastNotesCard" Margin="0,10,0,0" Padding="10"
                        CornerRadius="10" Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="UpdateToastNotes" Style="{StaticResource SubText}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Padding="18,10"
                            Content="{DynamicResource t_updates_toast_update}"
                            AutomationProperties.Name="{DynamicResource t_updates_toast_update}"
                            Click="UpdateToastUpdate_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
