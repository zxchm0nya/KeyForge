<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Brand / Palette ===== -->
    <Color x:Key="BgDeep">#090B0F</Color>
    <Color x:Key="BgPanel">#101419</Color>
    <Color x:Key="BgCard">#151B22</Color>
    <Color x:Key="BgElevated">#1B232B</Color>
    <Color x:Key="BgHover">#222D35</Color>
    <Color x:Key="Border">#2B353E</Color>
    <Color x:Key="BorderStrong">#46535D</Color>

    <Color x:Key="Accent">#28D7B7</Color>
    <Color x:Key="AccentAlt">#61A8FF</Color>
    <Color x:Key="AccentGlow">#167B70</Color>

    <Color x:Key="TextPrimary">#F3F5FA</Color>
    <Color x:Key="TextSecondary">#AEB8C2</Color>
    <Color x:Key="TextMuted">#78838E</Color>

    <Color x:Key="Success">#34D399</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="Danger">#F87171</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="#090B0F" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="#101419" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#151B22" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#1B232B" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#222D35" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B353E" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#46535D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#28D7B7" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="#61A8FF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#167B70" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB8C2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#78838E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#090B0F" />

    <!-- Accent gradient -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28D7B7" Offset="0" />
        <GradientStop Color="#1EA7A2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandBanner" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B232B" Offset="0" />
        <GradientStop Color="#101419" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000" />

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="FontFamily">Segoe UI, Segoe UI Variable, Arial</FontFamily>
</ResourceDictionary>
