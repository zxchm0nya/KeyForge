<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ Window / Nav ============ -->
    <sys:String x:Key="t_app_subtitle">VIA-конфигуратор</sys:String>
    <sys:String x:Key="t_nav_devices">Устройства</sys:String>
    <sys:String x:Key="t_nav_keymap">Кеймап и макросы</sys:String>
    <sys:String x:Key="t_nav_lighting">Подсветка</sys:String>
    <sys:String x:Key="t_nav_keytest">Тест клавиш</sys:String>
    <sys:String x:Key="t_nav_settings">Настройки</sys:String>

    <sys:String x:Key="t_status_disconnected">Не подключено</sys:String>
    <sys:String x:Key="t_status_connected">Подключено</sys:String>
    <sys:String x:Key="t_status_last_device">Последняя клавиатура</sys:String>

    <sys:String x:Key="t_tooltip_min">Свернуть</sys:String>
    <sys:String x:Key="t_tooltip_max">Развернуть</sys:String>
    <sys:String x:Key="t_tooltip_restore">Восстановить</sys:String>
    <sys:String x:Key="t_tooltip_close">Закрыть</sys:String>
    <sys:String x:Key="t_tooltip_about">О программе</sys:String>
    <sys:String x:Key="t_config_badge">Конфиг: {0}</sys:String>

    <!-- ============ Devices ============ -->
    <sys:String x:Key="t_devices_title">Устройства</sys:String>
    <sys:String x:Key="t_devices_intro_title">Клавиатура и VIA JSON</sys:String>
    <sys:String x:Key="t_devices_intro_text">Загрузите JSON-определение клавиатуры. KeyForge применит из него раскладку, подсветку, кастомные кейкоды и попробует сам найти устройство по VID/PID.</sys:String>
    <sys:String x:Key="t_devices_btn_scan">Найти клавиатуры</sys:String>
    <sys:String x:Key="t_devices_btn_load">Загрузить конфиг (.json)</sys:String>
    <sys:String x:Key="t_devices_detected">Обнаруженные клавиатуры</sys:String>
    <sys:String x:Key="t_devices_none">Клавиатуры пока не найдены. Нажмите «Найти клавиатуры».</sys:String>
    <sys:String x:Key="t_devices_loaded">Загруженный конфиг</sys:String>
    <sys:String x:Key="t_msg_no_via">Клавиатуры VIA не найдены.</sys:String>
    <sys:String x:Key="t_msg_no_via_long">Клавиатура VIA не обнаружена.&#10;&#10;Убедитесь, что она подключена и использует прошивку VIA/QMK.</sys:String>
    <sys:String x:Key="t_msg_parse_failed">Не удалось разобрать этот JSON как VIA-определение клавиатуры.</sys:String>
    <sys:String x:Key="t_msg_parse_detail">Причина: {0}</sys:String>

    <!-- ============ Customization ============ -->
    <sys:String x:Key="t_settings_custom">Кастомизация</sys:String>
    <sys:String x:Key="t_custom_theme">Темы акцента</sys:String>
    <sys:String x:Key="t_custom_colors">Цвета интерфейса</sys:String>
    <sys:String x:Key="t_custom_accent">Акцент</sys:String>
    <sys:String x:Key="t_custom_bg">Фон окна</sys:String>
    <sys:String x:Key="t_custom_panel">Панели</sys:String>
    <sys:String x:Key="t_custom_card">Карточки</sys:String>
    <sys:String x:Key="t_custom_text">Текст</sys:String>
    <sys:String x:Key="t_custom_image">Фоновое изображение</sys:String>
    <sys:String x:Key="t_custom_image_pick">Выбрать фон…</sys:String>
    <sys:String x:Key="t_custom_image_clear">Убрать фон</sys:String>
    <sys:String x:Key="t_custom_dim">Затемнение фона · {0:0}%</sys:String>
    <sys:String x:Key="t_custom_blur">Размытие фона · {0:0}</sys:String>
    <sys:String x:Key="t_custom_reset">Сбросить оформление</sys:String>
    <sys:String x:Key="t_custom_preset_default">Стандартная</sys:String>
    <sys:String x:Key="t_custom_preset_violet">Фиолетовая</sys:String>
    <sys:String x:Key="t_custom_preset_blue">Синяя</sys:String>
    <sys:String x:Key="t_custom_preset_pink">Розовая</sys:String>
    <sys:String x:Key="t_custom_preset_orange">Оранжевая</sys:String>
    <sys:String x:Key="t_custom_preset_lime">Лаймовая</sys:String>
    <sys:String x:Key="t_dlg_load_title">Загрузка VIA-определения клавиатуры</sys:String>
    <sys:String x:Key="t_stat_connecting">Подключение к {0}…</sys:String>
    <sys:String x:Key="t_stat_failed_open">Не удалось открыть {0}. Возможно, его использует другое приложение.</sys:String>
    <sys:String x:Key="t_stat_failed_via">{0} найдено, но клавиатура не ответила на VIA/Vial запросы.&#10;1. Закройте VIA / usevia.app и другие конфигураторы, затем переподключите клавиатуру.&#10;2. Убедитесь, что прошивка собрана с поддержкой VIA (RAW_ENABLE) или Vial — без этого подключение невозможно.</sys:String>
    <sys:String x:Key="t_stat_connected_via">{0} подключено · VIA протокол v{1:0}</sys:String>
    <sys:String x:Key="t_stat_connected_vial">{0} подключено · протокол Vial</sys:String>
    <sys:String x:Key="t_stat_connected">{0} подключено</sys:String>
    <sys:String x:Key="t_stat_found_config_device">Найдено устройство из JSON: {0}. Подключаюсь…</sys:String>
    <sys:String x:Key="t_stat_config_loaded_no_device">JSON загружен. Устройство с таким VID/PID пока не найдено.</sys:String>

    <!-- ============ Keymap ============ -->
    <sys:String x:Key="t_keymap_title">Кеймап и макросы</sys:String>
    <sys:String x:Key="t_keymap_btn_read">Считать кеймап с устройства</sys:String>
    <sys:String x:Key="t_keymap_btn_clear">Очистить визуальную раскладку</sys:String>
    <sys:String x:Key="t_keymap_btn_export">Экспорт JSON</sys:String>
    <sys:String x:Key="t_keymap_empty">Загрузите конфиг на вкладке «Устройства», чтобы отрисовать кеймап.</sys:String>
    <sys:String x:Key="t_keymap_hint">Клик по клавише открывает назначение. После подключения изменения сразу отправляются в клавиатуру.</sys:String>
    <sys:String x:Key="t_msg_connect_first">Сначала подключите клавиатуру.</sys:String>
    <sys:String x:Key="t_msg_load_config_first">Сначала загрузите конфиг.</sys:String>
    <sys:String x:Key="t_dlg_export_title">Экспорт кеймапа в JSON</sys:String>
    <sys:String x:Key="t_stat_keymap_read">Кеймап считан с устройства.</sys:String>
    <sys:String x:Key="t_stat_keymap_failed">Не удалось считать кеймап: {0}</sys:String>
    <sys:String x:Key="t_stat_exported">Кеймап экспортирован.</sys:String>

    <!-- ============ Key picker ============ -->
    <sys:String x:Key="t_picker_title">Назначить кейкод</sys:String>
    <sys:String x:Key="t_picker_search">Поиск клавиши…</sys:String>
    <sys:String x:Key="t_picker_search_placeholder">Введите для фильтра (например A, F1, Ctrl)</sys:String>
    <sys:String x:Key="t_picker_clear">Очистить (NO)</sys:String>
    <sys:String x:Key="t_btn_ok">OK</sys:String>
    <sys:String x:Key="t_btn_cancel">Отмена</sys:String>
    <sys:String x:Key="t_stat_keycode_set">Клавише назначено {0}.</sys:String>

    <!-- ============ Lighting ============ -->
    <sys:String x:Key="t_light_title">Подсветка</sys:String>
    <sys:String x:Key="t_light_live_preview">Живой предпросмотр</sys:String>
    <sys:String x:Key="t_light_palette">Палитра</sys:String>
    <sys:String x:Key="t_light_type">Тип подсветки</sys:String>
    <sys:String x:Key="t_light_rgb">RGB Matrix / Underglow</sys:String>
    <sys:String x:Key="t_light_controls">Управление</sys:String>
    <sys:String x:Key="t_light_color1">Цвет</sys:String>
    <sys:String x:Key="t_light_color2">Цвет 2</sys:String>
    <sys:String x:Key="t_light_brightness">Яркость · {0:0}</sys:String>
    <sys:String x:Key="t_light_speed">Скорость · {0:0}</sys:String>
    <sys:String x:Key="t_light_btn_apply">Применить подсветку</sys:String>
    <sys:String x:Key="t_light_btn_save">Сохранить в клавиатуре</sys:String>
    <sys:String x:Key="t_light_save_tooltip">Сохраняет подсветку в память клавиатуры и запоминает профиль в приложении</sys:String>
    <sys:String x:Key="t_light_saved_check">Сохранено ✓</sys:String>
    <sys:String x:Key="t_light_hint">Подключите клавиатуру, чтобы читать и записывать параметры подсветки.</sys:String>
    <sys:String x:Key="t_light_no_config">Сначала загрузите JSON-конфиг клавиатуры на вкладке «Устройства» — эффекты и диапазоны подсветки берутся из файла, а не задаются по умолчанию.</sys:String>
    <sys:String x:Key="t_stat_lighting_applied">Подсветка применена.</sys:String>
    <sys:String x:Key="t_stat_lighting_saved">Подсветка сохранена в память клавиатуры.</sys:String>
    <sys:String x:Key="t_picker_color_title">Выбор цвета</sys:String>
    <sys:String x:Key="t_picker_red">Красный</sys:String>
    <sys:String x:Key="t_picker_green">Зелёный</sys:String>
    <sys:String x:Key="t_picker_blue">Синий</sys:String>

    <!-- ============ Key Test ============ -->
    <sys:String x:Key="t_keytest_title">Тест клавиш</sys:String>
    <sys:String x:Key="t_keytest_intro">Нажимайте клавиши: удерживаемые подсвечиваются бирюзовым, уже проверенные остаются светлыми. Для точного совпадения символов используйте английскую раскладку.</sys:String>
    <sys:String x:Key="t_keytest_count">{0} нажатий</sys:String>
    <sys:String x:Key="t_keytest_btn_clear">Сбросить</sys:String>
    <sys:String x:Key="t_keytest_matrix">Матрица VIA (из загруженного конфига)</sys:String>
    <sys:String x:Key="t_keytest_events">События HID</sys:String>
    <sys:String x:Key="t_keytest_no_events">Событий пока нет.</sys:String>

    <!-- ============ Settings ============ -->
    <sys:String x:Key="t_settings_title">Настройки</sys:String>
    <sys:String x:Key="t_settings_language">Язык интерфейса</sys:String>
    <sys:String x:Key="t_settings_lang_en">English</sys:String>
    <sys:String x:Key="t_settings_lang_ru">Русский</sys:String>
    <sys:String x:Key="t_settings_preferences">Предпочтения</sys:String>
    <sys:String x:Key="t_settings_remember_kb">Запоминать последнюю клавиатуру</sys:String>
    <sys:String x:Key="t_settings_remember_kb_hint">Автоматически подключать последнюю клавиатуру при запуске.</sys:String>
    <sys:String x:Key="t_settings_remember_cfg">Запоминать последний конфиг</sys:String>
    <sys:String x:Key="t_settings_remember_cfg_hint">Автоматически загружать последний VIA-конфиг при запуске.</sys:String>
    <sys:String x:Key="t_settings_about">О программе</sys:String>
    <sys:String x:Key="t_settings_version">Версия {0}</sys:String>
    <sys:String x:Key="t_settings_about_text">Десктопный конфигуратор для VIA-совместимых клавиатур. Загрузите VIA-определение, переназначьте клавиши, настройте подсветку и проверьте каждый переключатель.</sys:String>

    <!-- ============ About dialog ============ -->
    <sys:String x:Key="t_about_title">О программе KeyForge</sys:String>

</ResourceDictionary>
