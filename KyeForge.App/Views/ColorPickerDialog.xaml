<Window x:Class="KyeForge.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color" WindowStartupLocation="CenterOwner"
        Width="410" Height="510" ResizeMode="NoResize"
        Background="Transparent" FontFamily="{StaticResource FontFamily}"
        WindowStyle="None" AllowsTransparency="True"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="14" Padding="22" Margin="14"
            MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{DynamicResource t_picker_color_title}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <!-- Shade field: saturation (X) / brightness (Y) for the selected hue -->
            <Grid x:Name="SvArea" Height="200" Margin="0,16,0,0" Cursor="Cross"
                  PreviewMouseLeftButtonDown="Sv_MouseDown" PreviewMouseMove="Sv_MouseMove" PreviewMouseLeftButtonUp="Sv_MouseUp"
                  LostMouseCapture="Sv_LostMouseCapture">
                <Border x:Name="SvHue" CornerRadius="10" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2.5"
                             Fill="Transparent" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Hue rainbow -->
            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Height="26" Margin="4,16,4,0"
                    Cursor="Hand" ValueChanged="HueSlider_ValueChanged">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="14" CornerRadius="7" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                        <GradientStop Color="#FFFFFF00" Offset="0.167" />
                                        <GradientStop Color="#FF00FF00" Offset="0.333" />
                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                        <GradientStop Color="#FF0000FF" Offset="0.667" />
                                        <GradientStop Color="#FFFF00FF" Offset="0.833" />
                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Focusable="False" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#22FFFFFF" Stroke="White" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>

            <!-- Hex input + preview -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="HexBox" Grid.Column="1" Style="{StaticResource AppTextBox}" FontFamily="Consolas"
                         KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                <Border x:Name="Preview" Grid.Column="2" Width="52" Height="32" CornerRadius="8" Margin="10,0,0,0"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t_btn_cancel}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource t_btn_ok}" Click="OK_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
