<UserControl x:Class="KyeForge.App.Views.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Previews -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Live preview -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource CardHeader}" Text="{DynamicResource t_light_live_preview}" />
                        <Border x:Name="PreviewBox" Height="90" CornerRadius="12" Margin="0,10,0,0"
                                Background="{DynamicResource BgDeepBrush}">
                            <Grid x:Name="PreviewGlow" />
                        </Border>
                    </StackPanel>

                    <!-- Gradient palette swatches -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Style="{StaticResource CardHeader}" Text="{DynamicResource t_light_palette}" />
                        <ItemsControl x:Name="Swatches" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,8,8" Cursor="Hand"
                                            Background="{Binding Swatch}"
                                            MouseLeftButtonDown="Swatch_MouseLeftButtonDown" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Effect type -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource t_light_type}" Margin="4,0,0,8" />
            <Border x:Name="TypeCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <TextBlock Style="{StaticResource SubText}" Text="{DynamicResource t_light_rgb}" VerticalAlignment="Center" />
                    <ComboBox Style="{StaticResource AppComboBox}" Width="340" HorizontalAlignment="Right"
                              x:Name="EffectCombo" SelectionChanged="EffectCombo_SelectionChanged"
                              DropDownClosed="EffectCombo_DropDownClosed"
                              PreviewKeyDown="EffectCombo_PreviewKeyDown"
                              IsTextSearchEnabled="False" Focusable="False" />
                </Grid>
            </Border>

            <!-- No-config hint (settings come from the JSON file only) -->
            <Border x:Name="NoConfigHint" Style="{StaticResource CardStyle}" Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderStrongBrush}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,12,0" />
                    <TextBlock Style="{StaticResource SubText}" MaxWidth="640" HorizontalAlignment="Left"
                               Text="{DynamicResource t_light_no_config}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Controls -->
            <Border x:Name="ControlsCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{DynamicResource t_light_controls}" Margin="0,0,0,8" />

                    <!-- Color (single - VIA stores one HSV color) -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource t_light_color1}" Style="{StaticResource SubText}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" x:Name="Color1Box" Width="40" Height="24" CornerRadius="8"
                                Margin="0,0,10,0" HorizontalAlignment="Left" Background="White" Cursor="Hand"
                                MouseLeftButtonDown="Color1Box_MouseLeftButtonDown" />
                        <TextBlock Grid.Column="2" x:Name="Color1Hex" Text="#FFFFFF" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Brightness -->
                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding BrightnessLabel}" Style="{StaticResource SubText}" />
                        <Slider Grid.Row="1" x:Name="BrightnessSlider" Style="{StaticResource AppSlider}" Minimum="0" Maximum="255"
                                Margin="0,8,0,0" ValueChanged="BrightnessSlider_ValueChanged" />
                    </Grid>

                    <!-- Speed -->
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SpeedLabel}" Style="{StaticResource SubText}" />
                        <Slider Grid.Row="1" x:Name="SpeedSlider" Style="{StaticResource AppSlider}" Minimum="0" Maximum="255"
                                Margin="0,8,0,0" ValueChanged="SpeedSlider_ValueChanged" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="BtnSaveLighting" Style="{StaticResource PrimaryButton}"
                                Content="{DynamicResource t_light_btn_save}"
                                ToolTip="{DynamicResource t_light_save_tooltip}"
                                Click="BtnSaveLighting_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LightingHint" Style="{StaticResource MutedText}" Margin="4,0,0,0"
                       Text="{DynamicResource t_light_hint}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>