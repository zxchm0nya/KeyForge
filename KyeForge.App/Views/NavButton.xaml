<UserControl x:Class="KyeForge.App.Views.NavButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Cursor="Hand">
    <UserControl.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1" />
    </UserControl.RenderTransform>
    <UserControl.RenderTransformOrigin>
        <Point X="0.5" Y="0.5" />
    </UserControl.RenderTransformOrigin>
    <Border x:Name="Container" CornerRadius="12" Padding="14,12" Margin="0,2"
            BorderThickness="1" BorderBrush="Transparent">
        <StackPanel Orientation="Horizontal" Margin="1">
            <TextBlock x:Name="IconText" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="LabelText" FontSize="14" FontWeight="Medium"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>