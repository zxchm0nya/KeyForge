<Window x:Class="KyeForge.App.Views.KeycodePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign keycode"
        WindowStartupLocation="CenterOwner"
        Width="420" Height="520" MinHeight="400"
        Background="{StaticResource BgPanelBrush}" FontFamily="{StaticResource FontFamily}"
        WindowStyle="None" AllowsTransparency="True"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource t_picker_title}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource AppTextBox}" Margin="0,12,0,10"
                     ToolTip="{DynamicResource t_picker_search_placeholder}"
                     TextChanged="SearchBox_TextChanged" />

            <ListBox x:Name="KeyList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PickerItemStyle}"
                     SelectionChanged="KeyList_SelectionChanged"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Hex}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnClear" Style="{StaticResource SecondaryButton}"
                        Content="{DynamicResource t_picker_clear}" Margin="0,0,10,0"
                        Click="BtnClear_Click" />
                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t_btn_cancel}"
                        Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="BtnOk" Style="{StaticResource PrimaryButton}" Content="{DynamicResource t_btn_ok}"
                        Click="OK_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>