<UserControl x:Class="KyeForge.App.Views.KeymapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnReadKeymap" Style="{StaticResource PrimaryButton}"
                            Content="{DynamicResource t_keymap_btn_read}"
                            Margin="0,0,12,0" Click="BtnReadKeymap_Click" />
                    <Button x:Name="BtnBlankBoard" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource t_keymap_btn_clear}"
                            Click="BtnBlankBoard_Click" Margin="0,0,12,0" />
                    <Button x:Name="BtnSaveLayout" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource t_keymap_btn_export}"
                            Click="BtnSaveLayout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      x:Name="ScrollHost">
            <Grid MinWidth="820" MinHeight="420">
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="EmptyMsg" Style="{StaticResource SubText}"
                                   Text="{DynamicResource t_keymap_empty}" TextWrapping="Wrap" />
                        <TextBlock x:Name="HintMsg" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="{DynamicResource t_keymap_hint}" Margin="0,0,0,8" />
                        <ContentControl x:Name="CanvasHost" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>