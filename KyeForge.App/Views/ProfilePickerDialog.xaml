<Window x:Class="KyeForge.App.Views.ProfilePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add profile" WindowStartupLocation="CenterOwner"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Background="Transparent" FontFamily="{StaticResource FontFamily}"
        WindowStyle="None" AllowsTransparency="True"
        KeyDown="OnKeyDown">
    <Border Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="14" Padding="22" Margin="14"
            MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource t_settings_profiles_add}"
                       Margin="0,0,0,12" />
            <TextBlock Style="{StaticResource SubText}" Text="{DynamicResource t_settings_profiles_proc}" />
            <ComboBox x:Name="ProcessCombo" Style="{StaticResource AppComboBox}"
                      Margin="0,6,0,0" Height="36" />
            <TextBlock Style="{StaticResource SubText}" Text="{DynamicResource t_settings_profiles}"
                       Margin="0,12,0,0" />
            <TextBox x:Name="NameBox" Style="{StaticResource AppTextBox}"
                     Margin="0,6,0,0" Height="36" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                        Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="OK"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
