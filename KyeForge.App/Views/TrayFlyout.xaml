<Window x:Class="KyeForge.App.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="300" Opacity="0">
    <Border CornerRadius="14" Padding="14" Margin="6"
            Background="{DynamicResource BgCardBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B7690" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" FontSize="12.5" FontWeight="SemiBold" MaxWidth="230"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Text="{DynamicResource t_tray_profile}" Style="{StaticResource SubText}" Margin="0,12,0,4" />
            <ComboBox x:Name="ProfileBox" Style="{StaticResource AppComboBox}"
                      DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged" />
            <TextBlock x:Name="NoProfilesText" Text="{DynamicResource t_tray_noprofiles}"
                       Style="{StaticResource SubText}" Visibility="Collapsed" />

            <Button x:Name="LightButton" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                    HorizontalContentAlignment="Center" Click="LightButton_Click" />
            <Button x:Name="ErrorsButton" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                    HorizontalContentAlignment="Center" Visibility="Collapsed" Click="ErrorsButton_Click" />

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,12" />

            <Button Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center"
                    Content="{DynamicResource t_tray_open}" Click="OpenButton_Click" />
            <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Center" Margin="0,8,0,0"
                    Content="{DynamicResource t_tray_exit}" Click="ExitButton_Click" />
        </StackPanel>
    </Border>
</Window>
