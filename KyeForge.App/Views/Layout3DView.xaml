<UserControl x:Class="KyeForge.App.Views.Layout3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Style="{StaticResource CardStyle}" Padding="8">
        <Grid>
            <Viewport3D x:Name="Viewport"
                        MouseLeftButtonDown="Viewport_MouseDown"
                        MouseMove="Viewport_MouseMove"
                        MouseLeftButtonUp="Viewport_MouseUp"
                        MouseWheel="Viewport_Wheel" />
            <TextBlock x:Name="HintText"
                       Style="{StaticResource MutedText}"
                       Text="{DynamicResource t_keytest_3d_hint}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,4" IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
