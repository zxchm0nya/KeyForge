<UserControl x:Class="KyeForge.App.Views.KeyTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{DynamicResource t_keytest_title}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" />
                    <Button x:Name="BtnClearTest" Style="{StaticResource SecondaryButton}"
                            Content="{DynamicResource t_keytest_btn_clear}"
                            Click="BtnClearTest_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource t_keytest_matrix}" Margin="4,0,0,8" />
                <Border x:Name="BoardShell" Style="{StaticResource CardStyle}" Padding="12"
                        Background="{DynamicResource BgDeepBrush}">
                    <ContentControl x:Name="TestCanvas" />
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource t_keytest_events}" Margin="4,14,0,8" />
                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <TextBlock x:Name="EventLog" Style="{StaticResource SubText}"
                               Text="{DynamicResource t_keytest_no_events}"
                               TextWrapping="Wrap" MaxHeight="120" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
