<Window x:Class="KyeForge.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KyeForge Installer"
        Width="640" Height="520"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="{StaticResource FontFamily}"
        WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#0A0E17" CornerRadius="16" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" CornerRadius="15,15,0,0" Padding="24,18">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                            <Image Source="Resources/app.ico" Width="27" Height="27"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KyeForge Setup" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Keyboard Configurator · v1.0.0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource BgCardBrush}" Cursor="Hand"
                            HorizontalAlignment="Right" ToolTip="Close" MouseLeftButtonUp="Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Steps -->
            <Border Grid.Row="1" Margin="24,16,24,0">
                <ItemsControl x:Name="StepsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="2" Margin="24,16,24,0">
                <!-- Step 1: Welcome -->
                <StackPanel x:Name="StepWelcome">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Welcome!" />
                    <TextBlock Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="This wizard will install KyeForge — a desktop configurator for VIA-compatible keyboards. You'll be able to load any VIA JSON definition, configure keymaps, macros and lighting, and test your keys." />
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                            Margin="0,18,0,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Key features" FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0"
                                       Text="•  Connect VIA/QMK keyboards over raw HID" />
                            <TextBlock Style="{StaticResource SubText}" Margin="0,3,0,0"
                                       Text="•  Load any VIA JSON keyboard definition" />
                            <TextBlock Style="{StaticResource SubText}" Margin="0,3,0,0"
                                       Text="•  Keymap &amp; macros · lighting · key tester" />
                            <TextBlock Style="{StaticResource SubText}" Margin="0,3,0,0"
                                       Text="•  Remembers your keyboard and config" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 2: Path -->
                <StackPanel x:Name="StepPath" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Choose install location" />
                    <TextBlock Style="{StaticResource SubText}" Margin="0,8,0,14"
                               Text="Select the folder where KyeForge will be installed." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPath" Style="{StaticResource AppTextBox}" Text="C:\Program Files\KyeForge" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse…"
                                Margin="10,0,0,0" Click="Browse_Click" />
                    </Grid>
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Add Desktop shortcut" IsChecked="True"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                              Margin="0,18,0,0" />
                    <CheckBox x:Name="LaunchAfter" Content="Launch KyeForge after install" IsChecked="True"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                              Margin="0,10,0,0" />
                </StackPanel>

                <!-- Step 3: Progress -->
                <StackPanel x:Name="StepProgress" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Installing…" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource SubText}" Margin="0,8,0,16"
                               Text="Copying files…" />
                    <ProgressBar x:Name="InstallProgress" Height="10" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource AccentGradient}" Background="{StaticResource BgElevatedBrush}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- Step 4: Done -->
                <StackPanel x:Name="StepDone" Visibility="Collapsed">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SuccessBrush}" Opacity="0.15"
                            HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="DoneTitle" Style="{StaticResource SectionTitle}" Text="Installation complete" Margin="0,14,0,0" />
                    <TextBlock x:Name="DoneSub" Style="{StaticResource SubText}" Margin="0,8,0,0"
                               Text="KyeForge is now ready to use. Plug in your VIA keyboard and load a config to get started." />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Margin="24,8,24,22">
                <Grid>
                    <Button x:Name="BtnBack" Style="{StaticResource SecondaryButton}" Content="Back"
                            HorizontalAlignment="Left" Visibility="Collapsed" Click="Back_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButton}" Content="Cancel"
                                Margin="0,0,10,0" Click="Cancel_Click" />
                        <Button x:Name="BtnNext" Style="{StaticResource PrimaryButton}" Content="Install"
                                Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
