<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette ===== -->
    <Color x:Key="BgDeep">#0B0F1A</Color>
    <Color x:Key="BgPanel">#101624</Color>
    <Color x:Key="BgCard">#161D31</Color>
    <Color x:Key="BgElevated">#1C2540</Color>
    <Color x:Key="BgHover">#222C4C</Color>
    <Color x:Key="Border">#232D4A</Color>
    <Color x:Key="BorderStrong">#2E3A5F</Color>
    <Color x:Key="Accent">#6C8CFF</Color>
    <Color x:Key="AccentAlt">#8F6CFF</Color>
    <Color x:Key="TextPrimary">#F3F5FA</Color>
    <Color x:Key="TextSecondary">#A6B0C9</Color>
    <Color x:Key="TextMuted">#6B7690</Color>
    <Color x:Key="Success">#34D399</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="#0B0F1A" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="#101624" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#161D31" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#1C2540" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#222C4C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#232D4A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2E3A5F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="#8F6CFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6B0C9" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7690" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6C8CFF" Offset="0" />
        <GradientStop Color="#8F6CFF" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000" />
    <FontFamily x:Key="FontFamily">Segoe UI, Segoe UI Variable, Arial</FontFamily>
</ResourceDictionary>